# Supabase Configuration
# Get these values from your Supabase project dashboard at https://supabase.com

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Supabase Anonymous/Public Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (NEVER expose to browser - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Note: The service role key should only be used in server-side code (API routes, server components)
# The anon key is safe to use in client-side code and has Row Level Security applied
